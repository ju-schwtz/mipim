<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão tracejado "Nova coleção" no fim da grade (como "Nova estante" no protótipo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_dashed_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="150dp"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_add"
        app:tint="@color/fuchsia_plum" />

    <TextView
        style="@style/Mipim.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nova coleção" />
</LinearLayout>
