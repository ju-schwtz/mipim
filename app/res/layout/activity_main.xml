<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Cabeçalho: título + botão redondo de adicionar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Mipim.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Biblioteca" />

        <ImageButton
            android:id="@+id/fabAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="Adicionar coleção"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Busca (história 19) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.Mipim.TextInput.Search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:hint="Buscar por título"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/dusty_mauve">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filtros (história 20) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/Widget.Mipim.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompletas"
                style="@style/Widget.Mipim.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIncompletas"
                style="@style/Widget.Mipim.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incompletas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFaltantes"
                style="@style/Widget.Mipim.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Com faltantes" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Mensagem de lista vazia / sem resultado -->
    <TextView
        android:id="@+id/tvVazio"
        style="@style/Mipim.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Grade de coleções (2 colunas) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColecoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/vintage_berry" />
    </FrameLayout>

    <include
        android:id="@+id/navBar"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
